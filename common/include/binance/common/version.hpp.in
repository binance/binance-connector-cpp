#pragma once

#include <string_view>

#include <binance/common/export.hpp>

namespace binance::common {

inline constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

/// The version the library was built as. Differs from `kVersion` on a header / library mismatch.
BINANCE_COMMON_EXPORT std::string_view sdk_version() noexcept;

} // namespace binance::common
